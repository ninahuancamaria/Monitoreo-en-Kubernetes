{
  "__inputs": [],
  "__requires": [],
  "annotations": { "list": [] },
  "description": "Dashboard de monitoreo — Clínica Veterinaria",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "id": 1,
      "title": "Estado de Servicios",
      "type": "stat",
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } },
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "up{job=~\"pacientes-service-monitor|citas-service-monitor\"}",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 2,
      "title": "Tasa de Requests — pacientes-service (req/min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{job=\"pacientes-service-monitor\"}[5m]) * 60",
          "legendFormat": "{{method}} {{uri}} — {{status}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 3,
      "title": "Tasa de Requests — citas-service (req/min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{job=\"citas-service-monitor\"}[5m]) * 60",
          "legendFormat": "{{method}} {{uri}} — {{status}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 4,
      "title": "Latencia p95 — pacientes-service (segundos)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "custom": { "lineWidth": 2, "fillOpacity": 15 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket{job=\"pacientes-service-monitor\"}[5m]))",
          "legendFormat": "p95 pacientes-service",
          "refId": "A"
        }
      ]
    },

    {
      "id": 5,
      "title": "Latencia llamadas pacientes→ citas (Timer Micrometer)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "custom": { "lineWidth": 2, "fillOpacity": 15 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(citas_latencia_llamada_pacientes_segundos_sum[5m]) / rate(citas_latencia_llamada_pacientes_segundos_count[5m])",
          "legendFormat": "Latencia media llamada a pacientes-service",
          "refId": "A"
        }
      ]
    },

    {
      "id": 6,
      "title": "Pacientes Activos (Gauge)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 20 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green", "value": 3 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "pacientes_activos_actual",
          "legendFormat": "Pacientes activos",
          "refId": "A"
        }
      ]
    },

    {
      "id": 7,
      "title": "Citas Pendientes y Confirmadas (Gauge)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 20 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "citas_pendientes_actual",
          "legendFormat": "Pendientes",
          "refId": "A"
        },
        {
          "expr": "citas_confirmadas_actual",
          "legendFormat": "Confirmadas",
          "refId": "B"
        }
      ]
    },

    {
      "id": 8,
      "title": "Errores de Comunicación entre Servicios (Counter)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": { "lineWidth": 2, "fillOpacity": 20 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(citas_errores_comunicacion_pacientes_total[5m]) * 60",
          "legendFormat": "Errores comunicación/min (timeout a pacientes-service)",
          "refId": "A"
        }
      ]
    },

    {
      "id": 9,
      "title": "Delay Artificial en pacientes-service (Casuística 2)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 28 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1000 },
              { "color": "red", "value": 2500 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "pacientes_delay_artificial_ms",
          "legendFormat": "Delay artificial (ms)",
          "refId": "A"
        }
      ]
    },

    {
      "id": 10,
      "title": "Total Citas Agendadas vs Rechazadas (Negocio)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Rechazadas/min" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Agendadas/min" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          }
        ]
      },
      "targets": [
        {
          "expr": "rate(citas_agendadas_total[5m]) * 60",
          "legendFormat": "Agendadas/min",
          "refId": "A"
        },
        {
          "expr": "rate(citas_rechazadas_paciente_invalido_total[5m]) * 60",
          "legendFormat": "Rechazadas/min",
          "refId": "B"
        }
      ]
    },

    {
      "id": 11,
      "title": "Total Pacientes Registrados (Counter acumulado)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 28 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "blue" }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "pacientes_registrados_total",
          "legendFormat": "Total registrados",
          "refId": "A"
        }
      ]
    }

  ],
  "refresh": "15s",
  "schemaVersion": 38,
  "tags": ["veterinaria", "microservicios", "kubernetes"],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Clínica Veterinaria — Monitoreo de Microservicios",
  "uid": "veterinaria-k8s-dashboard",
  "version": 1
}
